[Unit]
Description=RepublicMP Crash & Desync Collector (local spool writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=republicmp
Group=republicmp
UMask=0027
EnvironmentFile=/etc/republicmp-collector.env
ExecStart=/usr/bin/python3 -u /opt/republicmp-collector/collector.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/republicmp/spool

[Install]
WantedBy=multi-user.target
